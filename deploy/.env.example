# Settings for docker-compose.yml. Copy this file to .env beside it, and change what applies.

# Required: the address the page is served on. A domain name that points at this machine gets HTTPS
# by itself; :80 serves plain HTTP, for a trial.
WHIST_DOMAIN=

# Required: the game server the page talks to, as one of
#   host.docker.internal:8080   a server on this machine. On Linux it must listen on the Docker
#                               bridge's address (usually 172.17.0.1), not on 127.0.0.1 alone, and
#                               one you built needs the host's firewall to let Docker's networks in
#   server:8080                 a server container on a Docker network; the README has the override
#                               that joins the page to it
#   https://whist.example.org   a remote server behind its own TLS
WHIST_SERVER_ADDRESS=

# The image to run. Pin it in production, to a tag whose protocol label
# (io.github.conectionist.whist.protocol) equals the server's.
#WHIST_WEB_TAG=latest
