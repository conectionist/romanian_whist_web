# Settings for docker-compose.yml. Copy this file to .env beside it, and change what applies.

# Required: the address the page is served on. A domain name that points at this machine gets HTTPS
# by itself; :80 serves plain HTTP, for a trial.
WHIST_DOMAIN=

# Required: the game server the page talks to. Use host:port for a server on a Docker network this
# container is on, host.docker.internal:8080 for one on this machine, or https://whist.example.org
# for a remote one behind its own TLS.
WHIST_SERVER_ADDRESS=

# The image to run. Pin it in production, to a tag whose protocol label
# (io.github.conectionist.whist.protocol) equals the server's.
#WHIST_WEB_TAG=latest
