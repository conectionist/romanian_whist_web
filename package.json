{
  "name": "romanian-whist-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "build:look": "tsc --noEmit && vite build --mode look",
    "look": "npm run build:look && playwright test --config playwright.look.config.ts",
    "compare": "python3 tools/pair_shots.py"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
